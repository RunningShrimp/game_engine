{
  "type": "BehaviorTree",
  "root": {
    "type": "Selector",
    "name": "Merchant Root",
    "children": [
      {
        "type": "Sequence",
        "name": "Trade Sequence",
        "children": [
          {
            "type": "Condition",
            "name": "Is Customer Near",
            "check": "distance_to_player < 3.0"
          },
          {
            "type": "Action",
            "name": "Greet Customer",
            "execute": "play_greeting_animation"
          },
          {
            "type": "Action",
            "name": "Show Wares",
            "execute": "open_shop_ui"
          }
        ]
      },
      {
        "type": "Sequence",
        "name": "Idle Sequence",
        "children": [
          {
            "type": "Action",
            "name": "Stand at Counter",
            "execute": "move_to_counter"
          },
          {
            "type": "Action",
            "name": "Look Around",
            "execute": "idle_animation"
          }
        ]
      },
      {
        "type": "Action",
        "name": "Wait",
        "execute": "wait"
      }
    ]
  }
}
