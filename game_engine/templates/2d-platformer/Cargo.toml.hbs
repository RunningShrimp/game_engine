[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
authors = ["Your Name <your.email@example.com>"]
description = "{{name_title}} - A 2D platformer game built with Game Engine"
license = "MIT OR Apache-2.0"

[dependencies]
game_engine = { version = "{{engine_version}}", features = ["physics", "2d"] }
log = "0.4"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["fmt"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

[features]
default = ["physics"]
physics = []
