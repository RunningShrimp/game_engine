# 代码覆盖率配置文件
# 用于 cargo-tarpaulin 和 grcov

[run]
# 排除的文件和目录
omit = [
    "*/tests/*",
    "*/benches/*",
    "*/examples/*",
    "*/target/*",
    "*/src/bindings/*",
]

# 包含的文件
include = [
    "game_engine/src/**/*.rs",
    "game_engine_*/src/**/*.rs",
]

# 分支覆盖率
branch = true

# 并行执行
parallel = true

# 超时设置（秒）
timeout = 300

[report]
# 排除的文件模式
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise AssertionError",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
    "if TYPE_CHECKING:",
    "if False:",
    "class .*\\bProtocol\\):",
    "@(abc\\.)?abstractmethod",
]

# 精度设置
precision = 2

# 显示缺失的行
show_missing = true

# 跳过空文件
skip_empty = true

